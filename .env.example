# Optional, sector-agnostic — OpenAI key used by core/entity/ai_based.py to
# turn the raw question into cleaner search keywords and a more reliable
# primary_intent classification. Every sector benefits from this, not just
# sk_hynix. Falls back to the plain rule-based keyword split + keyword-rule
# intent classification when unset.
TRENDSPARC_ENTITY_AI_API_KEY=

# Optional — used only by scripts/diagnose_source_collection_methods.py to
# exercise the real extract_entities_ai() code path in isolation from the
# production TRENDSPARC_ENTITY_AI_API_KEY budget/key above. The script
# temporarily injects this value into TRENDSPARC_ENTITY_AI_API_KEY in its own
# process only; no other code reads this var. Leave unset to let the
# diagnostic fall back to the free rule-based entity extractor instead.
TRENDSPARC_DIAGNOSTIC_ENTITY_AI_API_KEY=

# Required by sectors/sk_hynix/adapter/collector — Firecrawl API key used to
# fetch and clean each registered source's pages into markdown.
FIRECRAWL_API_KEY=

# Required by sectors/sk_hynix/adapter/analyzer — OpenAI API key used to run
# sectors/sk_hynix/prompts/system_prompt.md against collected documents.
TRENDSPARC_SK_HYNIX_ANALYZER_API_KEY=

# Required by sectors/sk_planet/adapter/analyzer — OpenAI API key used to run
# sectors/sk_planet/prompts/system_prompt.md against collected documents.
TRENDSPARC_SK_PLANET_ANALYZER_API_KEY=

# Required by sectors/sk_telecom/adapter/analyzer — OpenAI API key used to run
# sectors/sk_telecom/prompts/system_prompt.md against collected documents.
TRENDSPARC_SK_TELECOM_ANALYZER_API_KEY=

# Required by sectors/sk_innovation/adapter/analyzer — OpenAI API key used to
# run sectors/sk_innovation/prompts/system_prompt.md against collected documents.
TRENDSPARC_SK_INNOVATION_ANALYZER_API_KEY=

# General fallback analyzer for questions that do not route to an SK sector.
TRENDSPARC_GENERAL_ANALYZER_API_KEY=
TRENDSPARC_GENERAL_ANALYZER_MODEL=gpt-4o-mini


# Required by sectors/sk_broadband/adapter/analyzer — OpenAI API key used to run
# sectors/sk_broadband/prompts/system_prompt.md against collected documents.
TRENDSPARC_SK_BROADBAND_ANALYZER_API_KEY=
TRENDSPARC_SK_BROADBAND_ANALYZER_MODEL=gpt-4o
# Optional — 긴 PDF를 12,000자 청크로 나눌 때 분석할 최대 청크 수.
# 기본값 12. 초과 PDF는 첫/마지막 청크와 질문 관련도가 높은 청크를 선택한다.
TRENDSPARC_SK_BROADBAND_ANALYZER_MAX_PDF_CHUNKS=12

# Optional — sk_broadband collector에서 OpenAI Responses API web_search 툴로
# (도메인 제한 없이 자유 검색) URL을 citation 및 web_search tool source 기반으로
# 찾는 AI 하네스를 켠다. 원 질문/관점/보고 목적/필요 증거/기준일을 전달하고,
# 한국 위치 힌트와 live web_search 실행을 강제한다. 질문당 최대 3라운드,
# 라운드당 URL 후보 5개, 후보 URL당 Firecrawl scrape 최초 1회와
# 예외·타임아웃 시 재시도 1회, 질문당 총 scrape 최대 25회로 비용을 제한한다.
# Firecrawl 원문을 GPT Structured Outputs로 평가하고, 질문 관련 원문 5건,
# 독립 출처 2곳 이상, 모든 information_needs 충족 시에만 sufficient를 인정한다.
# 충분성 하한은 5건이며 증거가 더 필요하면 최대 10건까지 보존한다.
# 부족한 증거 범주는 다음 라운드의 후속 검색어 생성에 사용한다.
# 찾은 URL은 등록된 소스 도메인과 사후 대조돼 일치하면 그 소스의 신뢰도로,
# 안 맞으면 reliability_tier 미설정(신뢰도를 지어내지 않음)으로 귀속된다.
# 미설정 시(기본값): 소스별로 기존 Firecrawl search() 로직을 그대로 사용한다.
# 설정 시: 질문 단위 하네스만 쓰고, 최대 3라운드와 전용 수집기 실행 후에도
# Validator가 누적 유효 원문 5건을 확보하지 못하면 수집 단계를 실패 처리한다. 레거시 검색으로
# 재시도하지 않는다 —
# 저품질 재시도로 토큰을 이중으로 쓰지 않기 위한 의도적 설계. 다른 단계처럼
# OPENAI_API_KEY로 자동 대체되지 않음 — 이 기능은 명시적으로 켜야 하는 추가
# 비용이기 때문.
TRENDSPARC_SK_BROADBAND_COLLECTOR_HARNESS_API_KEY=

# Optional — 위 하네스에 쓸 모델. Responses API의 web_search 툴을 지원해야 함.
# 기본값 gpt-4o는 기존 설정 호환을 위해 유지한다. Phase 1에서 추가된 required
# tool choice, user_location, external_web_access, action.sources 반환 옵션의 실제
# 계정/모델 조합은 운영 전 별도 라이브 검증이 필요하다. 다른 지원 모델을 쓸
# 경우 이 값을 명시적으로 변경한다.
TRENDSPARC_SK_BROADBAND_COLLECTOR_HARNESS_MODEL=gpt-4o

# Optional, sector-agnostic — OpenAI key used by core/synthesis/ai_based.py to
# de-duplicate, rank, and summarize the highlights concatenated by
# core/synthesis/synthesizer.py. Every sector benefits from this. Falls back
# to the plain concatenated (unranked, undeduped) highlights list when unset.
TRENDSPARC_SYNTHESIS_AI_API_KEY=

# Final report writer. Uses the full synthesis fields and produces distinct
# Executive Summary / Issue / Impact / Action-style structured sections.
TRENDSPARC_REPORT_GENERATOR_API_KEY=
TRENDSPARC_REPORT_GENERATOR_MODEL=gpt-4o-mini

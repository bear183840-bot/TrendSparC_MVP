# Optional, sector-agnostic — OpenAI key used by core/entity/ai_based.py to
# turn the raw question into cleaner search keywords and a more reliable
# primary_intent classification. Every sector benefits from this, not just
# sk_hynix. Falls back to the plain rule-based keyword split + keyword-rule
# intent classification when unset.
TRENDSPARC_ENTITY_AI_API_KEY=

# Required by sectors/sk_hynix/adapter/collector — Firecrawl API key used to
# fetch and clean each registered source's pages into markdown.
FIRECRAWL_API_KEY=

# Required by sectors/sk_hynix/adapter/analyzer — OpenAI API key used to run
# sectors/sk_hynix/prompts/system_prompt.md against collected documents.
TRENDSPARC_SK_HYNIX_ANALYZER_API_KEY=

# Required by sectors/sk_planet/adapter/analyzer — OpenAI API key used to run
# sectors/sk_planet/prompts/system_prompt.md against collected documents.
TRENDSPARC_SK_PLANET_ANALYZER_API_KEY=
